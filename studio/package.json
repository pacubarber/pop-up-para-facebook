{
  "name": "corte-studio",
  "version": "1.0.0",
  "private": true,
  "description": "CORTE — motor de edición con Remotion (portafolio + videos de prospección personalizados)",
  "type": "module",
  "scripts": {
    "setup": "python3 tools/audio.py && python3 tools/tts.py scripts/vo/*.json",
    "studio": "remotion studio",
    "render": "node scripts/render.mjs",
    "pitch": "node scripts/pitch.mjs",
    "frames": "bash scripts/frames.sh",
    "logos": "node scripts/build-logos.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/anton": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/inter-tight": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@remotion/bundler": "^4.0.534",
    "@remotion/cli": "^4.0.534",
    "@remotion/layout-utils": "^4.0.534",
    "@remotion/media-utils": "^4.0.534",
    "@remotion/noise": "^4.0.534",
    "@remotion/paths": "^4.0.534",
    "@remotion/renderer": "^4.0.534",
    "@remotion/shapes": "^4.0.534",
    "@remotion/transitions": "^4.0.534",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "remotion": "^4.0.534"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "opentype.js": "^2.0.0",
    "typescript": "^7.0.2"
  }
}
