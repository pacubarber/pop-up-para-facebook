 "lines": [
  {
   "voice": "voz",
   "text": "Nadie va a venir a salvarte."
  },
  {
   "voice": "voz",
   "text": "Ni tu jefe."
  },
  {
   "voice": "voz",
   "text": "Ni la suerte."
  },
  {
   "voice": "voz",
   "text": "Ni el lunes que viene."
  },
  {
   "voice": "voz",
   "text": "Eres tú."
  },
  {
   "voice": "voz",
   "text": "Solo tú."
  },
  {
   "voice": "voz",
   "text": "Cada vez que te rindes, le das la razón a quien dudó de ti."
  },
  {
   "voice": "voz",
   "text": "Cáete siete veces."
  },
  {
   "voice": "voz",
   "text": "Levántate ocho."
  },
  {
   "voice": "voz",
   "text": "Tu momento no llega."
  },
  {
   "voice": "voz",
   "text": "Se construye."
  },
  {
   "voice": "voz",
   "text": "Empieza hoy."
  }
 ]
